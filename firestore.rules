rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Data sensitif hanya dapat dibaca/diubah oleh admin dari panel.
    match /members/{nik} {
      allow read, write: if isAdmin();
    }

    // Form publik membaca kelas melalui Apps Script (IAM), bukan langsung dari browser.
    match /classes/{classCode} {
      allow read, create, update, delete: if isAdmin();

      match /vouchers/{voucherCode} {
        allow read, write: if isAdmin();
      }
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
